{
  "name": "kirby-locale",
  "version": "2.1.5",
  "description": "Locale utilities for Kirby CMS",
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "update:dev": "pnpm update --dev",
    "dev": "kirbyup serve src/index.js",
    "build": "kirbyup src/index.js",
    "lint": "eslint src tests && pnpm run lint:github",
    "lint:fix": "eslint src tests --fix",
    "format": "pnpm run lint:fix",
    "docs:lint": "markdownlint -c .markdownlint.json 'docs/**/*.md' 'README.md' 'CONTRIBUTING.md' 'SECURITY.md' 'AGENTS.md' 'STYLE_GUIDE.md'",
    "docs:check-next": "node ./tools/check-next.mjs",
    "docs:verify": "pnpm run docs:lint && pnpm run docs:links && pnpm run docs:check-next",
    "test:browser": "pnpm exec playwright test",
    "verify": "pnpm run build:check && pnpm run lint && pnpm run check:types && pnpm run test:bundle && pnpm run test:archive && pnpm run docs:verify && pnpm run test:browser && pnpm run test:release",
    "generate:iso": "node scripts/generate-iso-data.mjs",
    "prepare": "husky",
    "docs:links": "node tools/check-docs.mjs",
    "test:archive": "node tools/verify-release-archive.mjs",
    "test:bundle": "node tools/verify-panel-bundle.mjs",
    "test:browser:debug": "PLAYWRIGHT_SERVER_LOGS=1 pnpm exec playwright test --reporter=list",
    "test:browser:report": "pnpm exec playwright show-report playwright-report",
    "build:assets": "kirbyup src/index.js",
    "build:check": "node tests/reproducible-assets-command.mjs && node tools/check-reproducible-assets.mjs index.js index.css",
    "check:types": "tsc --version && tsc -p tsconfig.json --noEmit",
    "format:github": "prettier --write \".github/**/*.{yml,yaml}\"",
    "lint:github": "prettier --check \".github/**/*.{yml,yaml}\"",
    "test:release": "node --test tools/release-toolchain.test.mjs tools/third-party-notices.test.mjs tools/release-archive.test.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@formatjs/intl-displaynames": "^8.0.3",
    "@formatjs/intl-locale": "^5.5.0",
    "@playwright/test": "^1.65.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript/typescript6": "^6.0.2",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "kirbyup": "^3.5.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.10.1",
    "semantic-release": "^26.0.1",
    "typescript": "^7.0.2",
    "semver": "^7.8.6"
  },
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23",
    "pnpm": ">=12.21.0 <13"
  }
}
