{
  "name": "grommasdietz/kirby-locale",
  "description": "Locale utilities for Kirby CMS",
  "type": "kirby-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Grommas Dietz",
      "email": "info@grommas-dietz.com",
      "homepage": "https://grommas-dietz.com",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/grommasdietz/kirby-locale/issues",
    "source": "https://github.com/grommasdietz/kirby-locale",
    "docs": "https://github.com/grommasdietz/kirby-locale/blob/main/README.md"
  },
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "locale",
    "locales"
  ],
  "autoload": {
    "psr-4": {
      "GrommasDietz\\KirbyLocale\\": "lib/"
    }
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "vimeo/psalm": "^6.19.1",
    "friendsofphp/php-cs-fixer": "^3.93",
    "getkirby/cms": "^5.2"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.3.16"
    },
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration",
      "@test:smoke"
    ],
    "test:unit": "./vendor/bin/phpunit --testsuite Unit",
    "test:integration": "./vendor/bin/phpunit --testsuite Integration",
    "test:coverage": "./vendor/bin/phpunit --coverage-text",
    "psalm": "./vendor/bin/psalm --no-cache --show-info=true",
    "lint": "./vendor/bin/php-cs-fixer fix --dry-run --diff",
    "lint:fix": "./vendor/bin/php-cs-fixer fix",
    "format": "@lint:fix",
    "setup": [
      "composer install -d playground",
      "composer install"
    ],
    "verify": [
      "@lint",
      "@psalm",
      "@test"
    ],
    "notices:generate": "php tools/generate-third-party-notices.php",
    "post-update-cmd": "@notices:generate",
    "update:dev": "@composer update phpunit/phpunit vimeo/psalm friendsofphp/php-cs-fixer getkirby/cms --with-all-dependencies",
    "playground:update": "@composer --working-dir=playground update --with-all-dependencies",
    "test:smoke": "php tests/run.php",
    "release:check": "php tools/release-readiness.php"
  },
  "version": "2.1.3"
}
